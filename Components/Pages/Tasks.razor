@page "/tasks"
@inject IBaseRepository<AppTask> TaskRepo
@inject IAuthService AuthService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-4" Color="Color.Primary" Style="font-weight: bold;">Görev Yönetimi</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_showForm)
{
    <!-- YENİ/DÜZENLE FORM EKRANI -->
    <MudCard Elevation="3" Class="pa-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">@(_isEditing ? "Görevi Düzenle" : "Yeni Görev")</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudTextField @bind-Value="_currentTask.Title" Label="Görev Adı" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudTextField @bind-Value="_currentTask.Description" Label="Açıklama" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" Class="mb-3" />

            <MudSelect @bind-Value="_currentTask.Status" Label="Durum" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                @foreach (TechnicianApp.Core.Models.TaskStatus status in Enum.GetValues(typeof(TechnicianApp.Core.Models.TaskStatus)))
                {
                    <MudSelectItem Value="status">@status</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_currentTask.ActionsTaken" Label="Yapılan İşlemler (İsteğe Bağlı)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
        </MudCardContent>
        <MudCardActions Class="d-flex justify-end gap-2 mt-2">
            <MudButton OnClick="CancelForm" Variant="Variant.Text">İptal</MudButton>
            <MudButton OnClick="SaveTaskAsync" Variant="Variant.Filled" Color="Color.Primary">Kaydet</MudButton>
        </MudCardActions>
    </MudCard>
}
else
{
    <!-- GÖREVLER LİSTESİ -->
    <MudButton OnClick="OpenNewTaskForm" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mb-4">Yeni Görev Ekle</MudButton>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2 mt-2">
        <MudTabPanel Text="Bekleyen">
            @RenderTaskList(TechnicianApp.Core.Models.TaskStatus.Bekliyor)
        </MudTabPanel>
        <MudTabPanel Text="Yapılıyor">
            @RenderTaskList(TechnicianApp.Core.Models.TaskStatus.Yapiliyor)
        </MudTabPanel>
        <MudTabPanel Text="Tamamlandı">
            @RenderTaskList(TechnicianApp.Core.Models.TaskStatus.Tamamlandi)
        </MudTabPanel>
    </MudTabs>
}

@code {
    private List<AppTask> _tasks = new();
    private AppTask _currentTask = new();
    private bool _isLoading = true;
    private bool _showForm = false;
    private bool _isEditing = false;
    private string _userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user != null)
        {
            _userId = user.Id;
            await LoadTasksAsync();
        }
        else
        {
            Snackbar.Add("Oturum bulunamadı. Lütfen tekrar giriş yapın.", Severity.Error);
        }
    }

    private async Task LoadTasksAsync()
    {
        _isLoading = true;
        try
        {
            // İleride rol tabanlı filtreleme eklenebilir. Şimdilik ortak havuzu çekiyoruz.
            _tasks = await TaskRepo.GetAllAsync("Tasks");
        }
        catch (Exception)
        {
            Snackbar.Add("Görevler yüklenirken hata oluştu.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenNewTaskForm()
    {
        _currentTask = new AppTask { AssignedTechnicianId = _userId };
        _isEditing = false;
        _showForm = true;
    }

    private void EditTask(AppTask task)
    {
        // UI'daki objenin anında değişmemesi için kopya (shallow copy) oluşturuyoruz
        _currentTask = new AppTask
        {
            Id = task.Id,
            Title = task.Title,
            Description = task.Description,
            AssignedTechnicianId = task.AssignedTechnicianId,
            CreatedAt = task.CreatedAt,
            CompletedAt = task.CompletedAt,
            ActionsTaken = task.ActionsTaken,
            Status = task.Status
        };
        _isEditing = true;
        _showForm = true;
    }

    private void CancelForm()
    {
        _showForm = false;
        _currentTask = new();
    }

    private async Task SaveTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentTask.Title))
        {
            Snackbar.Add("Görev adı boş olamaz.", Severity.Warning);
            return;
        }

        try
        {
            // Görev tamamlandıysa bitiş tarihini otomatik ata
            if (_currentTask.Status == TechnicianApp.Core.Models.TaskStatus.Tamamlandi && _currentTask.CompletedAt == null)
            {
                _currentTask.CompletedAt = DateTime.UtcNow;
            }

            if (_isEditing)
            {
                await TaskRepo.UpdateAsync("Tasks", _currentTask, _currentTask.Id);
                Snackbar.Add("Görev güncellendi.", Severity.Success);
            }
            else
            {
                await TaskRepo.AddAsync("Tasks", _currentTask, _currentTask.Id);
                Snackbar.Add("Yeni görev eklendi.", Severity.Success);
            }

            _showForm = false;
            await LoadTasksAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("Kaydedilirken veritabanı hatası oluştu.", Severity.Error);
        }
    }

    private async Task DeleteTaskAsync(string id)
    {
        try
        {
            await TaskRepo.DeleteAsync("Tasks", id);
            Snackbar.Add("Görev başarıyla silindi.", Severity.Info);
            await LoadTasksAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("Silinirken hata oluştu.", Severity.Error);
        }
    }

    // Listeleri çizen yardımcı C# / HTML bloğu
    private RenderFragment RenderTaskList(TechnicianApp.Core.Models.TaskStatus statusFilter) => __builder =>
    {
        var filteredTasks = _tasks.Where(t => t.Status == statusFilter).OrderByDescending(t => t.CreatedAt).ToList();

        if (!filteredTasks.Any())
        {
            <MudText Class="mt-4" Align="Align.Center" Color="Color.Surface">Bu durumda listelenecek görev bulunmuyor.</MudText>
        }
        else
        {
            <MudGrid Class="mt-2">
                @foreach (var task in filteredTasks)
                {
                    <MudItem xs="12" sm="6">
                        <MudCard Elevation="2">
                            <MudCardContent>
                                <MudText Typo="Typo.h6">@task.Title</MudText>
                                <MudText Typo="Typo.body2" Class="mb-2">@task.Description</MudText>
                                @if (!string.IsNullOrEmpty(task.ActionsTaken))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Yapılan İşlem:</b> @task.ActionsTaken</MudText>
                                }
                            </MudCardContent>
                            <MudCardActions Class="d-flex justify-end">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => EditTask(task))" title="Düzenle" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteTaskAsync(task.Id))" title="Sil" />
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    };
}