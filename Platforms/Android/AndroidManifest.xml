<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.hnysoftware.teta">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:supportsRtl="true" android:label="Teknik Takip"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Bildirim gönderme izni (Android 13+) -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Tam zamanında hatırlatıcı çalıştırma izinleri (Android 12+) -->
	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
	<uses-permission android:name="android.permission.USE_EXACT_ALARM" />
